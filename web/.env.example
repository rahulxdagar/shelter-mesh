# All optional. Without them the app runs in dev mode (role picker, OpenStreetMap tiles).
# API base URL when the web app is hosted separately from the API (e.g. Vercel + Cloud Run).
VITE_API_URL=
# Auth0 SPA application
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.coldgrid
# Google Maps JavaScript API browser key (restrict by HTTP referrer) and a Map ID
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
