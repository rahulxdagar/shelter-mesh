# Everything is optional in development. Missing integrations fall back to local simulations.
PORT=8080
# NODE_ENV=production   # requires MONGODB_URI and Auth0

# MongoDB Atlas (omit to use an in-memory replica set)
MONGODB_URI=
MONGODB_DB=coldgrid

# Tiger Data (TimescaleDB) service URL for history (bed trends, weather, response times).
# Tiger Cloud: postgres://tsdbadmin:<password>@<id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Local (docker compose up timescale): postgres://postgres:coldgrid@localhost:5433/coldgrid
TIGER_DATABASE_URL=
HISTORY_SAMPLE_SECONDS=60

# Web origins allowed to call the API (comma separated). Empty = allow all (dev only).
CORS_ORIGINS=
# Public URL of this API, used to validate Twilio webhook signatures
PUBLIC_API_URL=

# Auth0 API (Applications > APIs). Enable RBAC and "Add Permissions in the Access Token".
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.coldgrid

# Google Routes API server key (restricted to the Routes API)
GOOGLE_MAPS_SERVER_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# On-call City Ops phones for Code Frost (E.164, comma separated)
ONCALL_NUMBERS=
# Field phones allowed to send "OD <lat>,<lng>" SMS alerts: +16135550101:auth0|user-id,...
FIELD_NUMBERS=

# Hedera Consensus Service (portal.hedera.com testnet account). Run `npm run hedera:topic` once.
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=
HEDERA_NETWORK=testnet

# Environment Canada city page id (on-118 = Ottawa) and thresholds
WEATHER_CITY_ID=on-118
WEATHER_POLL_MINUTES=15
CODE_FROST_CAPACITY_PCT=1
CODE_FROST_TEMP_C=-15
HOLD_MINUTES=45
RESPONDER_RADIUS_M=1000
# Set to false on the real deployment to hide surge/reset/weather override
DEMO_CONTROLS=true
